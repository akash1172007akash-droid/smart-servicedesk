# ====================================================================
# Smart ServiceDesk - Environment Configuration Template
# Copy this file to application.properties and customize for your environment.
# ====================================================================

server.port=8080

# Database Configuration
# Replace 'root' and 'YOUR_DB_PASSWORD' with your local MySQL credentials
spring.datasource.url=jdbc:mysql://localhost:3306/smart_servicedesk?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:YOUR_DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# JWT Security Configuration (Use a 256-bit secure secret key)
app.jwt.secret=${JWT_SECRET:404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970}
app.jwt.expiration-milliseconds=86400000

# File Upload Configuration
app.upload.dir=./uploads
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
